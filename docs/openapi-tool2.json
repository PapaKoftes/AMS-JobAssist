  "components": {
    "schemas": {
      "ApprovalRequest": {
        "properties": {
          "approval_status": {
            "type": "string",
            "title": "Approval Status"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback"
          },
          "approved_by": {
            "type": "string",
            "title": "Approved By"
          }
        },
        "type": "object",
        "required": [
          "approval_status",
          "approved_by"
        ],
        "title": "ApprovalRequest",
        "description": "Request to approve/reject a submission"
      },
      "Body_import_cvs_api_import_cvs_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_import_cvs_api_import_cvs_post"
      },
      "BulkApprovalRequest": {
        "properties": {
          "participant_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Participant Ids"
          },
          "approval_status": {
            "type": "string",
            "title": "Approval Status"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback"
          },
          "approved_by": {
            "type": "string",
            "title": "Approved By"
          }
        },
        "type": "object",
        "required": [
          "participant_ids",
          "approval_status",
          "approved_by"
        ],
        "title": "BulkApprovalRequest",
        "description": "Request to bulk approve/reject participants"
      },
      "BulkExportRequest": {
        "properties": {
          "participant_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Participant Ids"
          },
          "format": {
            "type": "string",
            "title": "Format",
            "default": "pdf"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "de"
          },
          "include_feedback": {
            "type": "boolean",
            "title": "Include Feedback",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "participant_ids"
        ],
        "title": "BulkExportRequest",
        "description": "Request to export multiple CVs"
      },
      "CVSectionEditRequest": {
        "properties": {
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "edited_text": {
            "type": "string",
            "title": "Edited Text"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "de"
          }
        },
        "type": "object",
        "required": [
          "question_id",
          "edited_text"
        ],
        "title": "CVSectionEditRequest",
        "description": "Request to persist a trainer's inline edit to one CV section."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LockRequest": {
        "properties": {
          "locked_by": {
            "type": "string",
            "title": "Locked By"
          }
        },
        "type": "object",
        "required": [
          "locked_by"
        ],
        "title": "LockRequest",
        "description": "Request body for lock / unlock operations."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
