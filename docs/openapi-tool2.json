              }
            }
          }
        }
      }
    },
    "/api/export-all": {
      "get": {
        "tags": [
          "Trainer Dashboard"
        ],
        "summary": "Export All Participants",
        "description": "Export ALL participants' CVs as a single zip archive (PDF or DOCX),\nor as a JSON bundle.\n\n- format=pdf   → zip of individual PDFs\n- format=docx  → zip of individual DOCX files\n- format=json  → single JSON bundle\n\nOptionally filter by cohort_id.",
        "operationId": "export_all_participants_api_export_all_get",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Export format: pdf, docx, or json",
              "default": "pdf",
              "title": "Format"
            },
            "description": "Export format: pdf, docx, or json"
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Output language: de or en",
              "default": "de",
              "title": "Language"
            },
            "description": "Output language: de or en"
          },
          {
            "name": "cohort_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optionally filter by cohort",
              "title": "Cohort Id"
