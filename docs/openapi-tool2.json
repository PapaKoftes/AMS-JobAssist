    },
    "/api/admin/backup": {
      "get": {
        "tags": [
          "Trainer Dashboard",
          "Admin"
        ],
        "summary": "Admin Backup",
        "description": "Download a CONSISTENT snapshot of the trainer SQLite database.\n\nSecurity: this endpoint exposes ALL participant PII, so it is gated\nindependently of the global AUTH_ENABLED flag. It is allowed only when the\nrequest comes from loopback (the trainer's own machine) OR a valid\nAMS_TRAINER_API_KEY is presented. A remote client without the key is always\nrefused, even if the dashboard otherwise runs without authentication.",
        "operationId": "admin_backup_api_admin_backup_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
