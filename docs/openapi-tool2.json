    "/api/participants/{participant_id}/lock": {
      "post": {
        "tags": [
          "Trainer Dashboard"
        ],
        "summary": "Lock Participant Cv",
        "description": "Lock a participant's CV — prevents any further edits by the participant.\n\nOnce locked, the interview engine rejects new answers for the linked session.\nTrainers can still edit inline via the dashboard.",
        "operationId": "lock_participant_cv_api_participants__participant_id__lock_post",
        "parameters": [
          {
            "name": "participant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Participant Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LockRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
