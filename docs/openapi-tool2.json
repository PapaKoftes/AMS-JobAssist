    "/api/import-cvs": {
      "post": {
        "tags": [
          "Trainer Dashboard",
          "Import"
        ],
        "summary": "Import Cvs",
        "description": "Import CVData JSON from Tool 1.\n\nSupports:\n- Single JSON file (one CV)\n- ZIP file with multiple JSONs\n\nFile size limited to MAX_UPLOAD_SIZE_MB.",
        "operationId": "import_cvs_api_import_cvs_post",
        "parameters": [
          {
            "name": "cohort_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cohort Id"
            }
          },
          {
            "name": "force_overwrite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Overwrite a locked/approved/trainer-edited submission instead of refusing",
              "default": false,
              "title": "Force Overwrite"
            },
            "description": "Overwrite a locked/approved/trainer-edited submission instead of refusing"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_import_cvs_api_import_cvs_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/participants": {
      "get": {
        "tags": [
          "Trainer Dashboard"
        ],
        "summary": "List Participants",
        "description": "List participants with optional filtering and pagination.\n\nQuery params:\n- cohort_id: Filter by cohort\n- status: Filter by approval status (pending/approved/rejected)\n- search: Search by name or email\n- min_quality: Only show participants with CV quality >= value (0.0–1.0)\n- max_quality: Only show participants with CV quality <= value (0.0–1.0)\n- page: Page number (default 1)\n- page_size: Items per page (default 50, max 200)",
        "operationId": "list_participants_api_participants_get",
        "parameters": [
          {
            "name": "cohort_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cohort Id"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          },
          {
            "name": "min_quality",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 1.0,
                  "minimum": 0.0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter to participants whose latest CV quality >= this value",
              "title": "Min Quality"
            },
            "description": "Filter to participants whose latest CV quality >= this value"
          },
          {
            "name": "max_quality",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 1.0,
                  "minimum": 0.0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter to participants whose latest CV quality <= this value",
              "title": "Max Quality"
            },
            "description": "Filter to participants whose latest CV quality <= this value"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
