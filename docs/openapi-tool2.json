    "/api/participants/{participant_id}/cv-section": {
      "patch": {
        "tags": [
          "Trainer Dashboard"
        ],
        "summary": "Update Cv Section",
        "description": "Persist a trainer's inline edit to one CV section.\n\nFinds the section by question_id inside cv_data_json and overwrites\nthe text for the requested language.  Records the change in the\nTrainerFeedback audit trail.",
        "operationId": "update_cv_section_api_participants__participant_id__cv_section_patch",
        "parameters": [
          {
            "name": "participant_id",
            "in": "path",
            "required": true,
            "schema": {
