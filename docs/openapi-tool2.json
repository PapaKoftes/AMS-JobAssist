    "/api/bulk-export": {
      "post": {
        "tags": [
          "Trainer Dashboard"
        ],
        "summary": "Bulk Export",
        "description": "Export multiple CVs in the requested format.\n\n- format=json  → single JSON bundle (always available)\n- format=pdf   → zip archive of individual PDFs (requires Tool 1)\n- format=docx  → zip archive of individual DOCX files (requires Tool 1)\n\nReturns a downloadable file (JSON, or a .zip for pdf/docx).",
        "operationId": "bulk_export_api_bulk_export_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkExportRequest"
              }
            }
          },
          "required": true
        },
