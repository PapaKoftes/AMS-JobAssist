# AMS JobAssist — Environment Configuration
#
# Copy this file to .env and fill in the values.
# None of these are required for single-machine offline use.
# They become important when deploying in a shared AMS training room.
#
# Usage:
#   cp .env.example .env
#   Edit .env, then: source .env (Linux/Mac) or set via Windows Environment Variables

# ── Server ────────────────────────────────────────────────────────────────────

# Host to bind (default: 127.0.0.1 — localhost only, no network exposure)
# Change to 0.0.0.0 only if Tool 1 must be accessed from other machines on the LAN
AMS_TOOL1_HOST=127.0.0.1
AMS_TOOL2_HOST=127.0.0.1

# Ports (default: 8000 for Tool 1, 8001 for Tool 2)
AMS_TOOL1_PORT=8000
AMS_TOOL2_PORT=8001

# ── Database ──────────────────────────────────────────────────────────────────

# Override the SQLite database file locations.
# Useful if the data directory should be on a backed-up network drive.
# Example: AMS_DATA_DIR=Z:\AMS-Daten\JobAssist
# Leave blank to use the default: <repo>/data/ inside each tool's folder.
AMS_DATA_DIR=

# ── Security (Trainer Dashboard) ─────────────────────────────────────────────

# API key required to access Tool 2 (trainer dashboard).
# REQUIRED if Tool 2 is exposed on a shared network.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank for single-machine offline use.
AMS_TRAINER_API_KEY=

# ── AI Model (Tool 1) ─────────────────────────────────────────────────────────

# Enable Ollama as a fallback AI (if you have Ollama installed with a German model).
# Default: true (uses Ollama if available, but it is completely optional).
AMS_USE_OLLAMA=true
AMS_OLLAMA_HOST=http://127.0.0.1:11434

# ── Privacy / Offline Mode ────────────────────────────────────────────────────

# When set to 1, the tool patches Python's socket module to block all
# non-localhost connections. This guarantees no data ever leaves the machine,
# but also disables any optional model download prompts.
# Default: 0 (network allowed for model downloads, but nothing is sent without consent)
AMS_ENFORCE_OFFLINE=0

# ── Data Retention ───────────────────────────────────────────────────────────

# Auto-delete interview sessions older than N days (0 = keep forever).
# Recommended for AMS classrooms: 90 days (one course cycle).
AMS_DATA_RETENTION_DAYS=0

# ── Upload Limits ─────────────────────────────────────────────────────────────

# Maximum file upload size in MB (default: 50). Applies to JSON import in Tool 2.
AMS_MAX_UPLOAD_MB=50

# ── Development / Debug ───────────────────────────────────────────────────────

# Enable debug mode (auto-reload, verbose errors). DO NOT use in production.
AMS_DEBUG=0
AMS_DB_ECHO=0

# Disable rate limiting (useful for automated testing). DO NOT use in production.
# AMS_DISABLE_RATE_LIMIT=0
